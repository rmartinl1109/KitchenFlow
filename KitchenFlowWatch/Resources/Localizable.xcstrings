    "sample.recipe.step4.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach und nach warme Brühe schöpfkellenweise unter ständigem Rühren zugeben. Zum Schluss mit Butter und Parmesan verfeinern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradually add warm broth ladle by ladle while stirring. Finish off the heat with grated parmesan and butter."
          }
