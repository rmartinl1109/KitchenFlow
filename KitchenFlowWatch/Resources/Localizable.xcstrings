    "sample.recipe.step3.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arborio-Reis hinzufügen, 1 Minute rühren und mit Weißwein ablöschen, bis der Alkohol verdampft ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add arborio rice, stir for 1 minute until translucent around the edges, then pour white wine until evaporated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir el arroz arborio, remover 1 minuto y verter el vino blanco hasta que evapore el alcohol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter le riz arborio, remuer 1 minute puis verser le vin blanc jusqu'à évaporation complète."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o arroz arbóreo, mexa por 1 minuto e despeje o vinho branco até que evapore o álcool."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入意米翻炒1分钟至米粒半透明，淋入白葡萄酒煮至酒精完全挥发。"
          }
        }
      }
    },
    "sample.recipe.step3.title" : {
      "extractionState" : "stale",
