        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir caldo poco a poco sin dejar de remover. Al final añadir queso parmesano y mantecar con mantequilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter le bouillon louche par louche en remuant constamment. Terminer hors du feu avec le parmesan et le beurre."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o caldo aos poucos mexendo sempre. Finalize fora do fogo com queijo parmesão e manteiga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "边搅拌边逐勺加入温热的高汤。离火后加入帕玛森芝士碎和黄油翻拌乳化。"
          }
        }
      }
    },
