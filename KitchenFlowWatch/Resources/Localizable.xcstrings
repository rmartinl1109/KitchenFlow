    "sample.recipe.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Präziser Timer-Ablauf für die perfekte sämige Konsistenz eines echten italienischen Risottos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise timer guide to achieve the authentic creamy texture of classic Italian risotto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guion de tiempos preciso para conseguir la textura cremosa perfecta del auténtico risotto italiano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guide de minuterie précis pour obtenir la texture crémeuse parfaite de l'authentique risotto italien."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guia de tempo preciso para obter a textura cremosa perfeita do autêntico risoto italiano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确的分步计时器指南，助您做出纯正意式浓郁奶油烩饭。"
          }
        }
      }
    },
    "sample.recipe.step1.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Brühe bei schwacher Hitze warmhalten, damit sie leicht eingearbeitet werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the broth warm in a pot over low heat so it incorporates easily into the risotto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poner el caldo en una cazuela a fuego medio-bajo para mantenerlo siempre caliente al incorporarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenir le bouillon au chaud à feu doux afin de l'incorporer progressivement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o caldo aquecido em fogo baixo para facilitar a incorporação ao risoto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用小火保持高汤温热，以便随时分次加入烩饭。"
          }
        }
      }
    },
    "sample.recipe.step1.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemüsebrühe erwärmen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm Vegetable Broth"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calentar caldo de verduras"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chauffer le bouillon de légumes"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquecer caldo de legumes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加热蔬菜高汤"
          }
        }
      }
    },
    "sample.recipe.step2.alert" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanft umrühren, damit die Schalotten nicht zu dunkel werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently stir aromatics to prevent browning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover el sofrito para evitar que la cebolla se dore demasiado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remuer doucement pour éviter que les oignons ne colorent trop"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mexer suavemente para não dourar demais a cebola"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻轻翻炒，防止红葱头焦糊"
          }
        }
      }
    },
    "sample.recipe.step2.instructions" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer großen Pfanne mit Olivenöl und Butter die gehackten Schalotten und Pilzscheiben anschwitzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a wide pan with olive oil and butter, gently sauté the finely chopped shallots and sliced mushrooms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una sartén amplia con aceite de oliva y mantequilla, pochar la chalota picada y las setas laminadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans une grande poêle avec de l'huile d'olive et du beurre, faire suer l'échalote et les champignons émincés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em uma frigideira ampla com azeite e manteiga, refogue as chalotas picadas e os cogumelos fatiados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在宽口平底锅中加入橄榄油和黄油，轻轻煸炒切碎的红葱头和切片蘑菇。"
          }
        }
      }
    },
    "sample.recipe.step2.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalotten und Pilze anschwitzen"
          }
        },
        "en" : {
